DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password
REDIS_URL=rediss://:<upstash-token>@<upstash-host>:6380
JWT_SECRET=change-me-to-a-256-bit-base64-encoded-random-string
JWT_EXPIRATION_MS=86400000
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
# Optional but strongly recommended: raises GitHub API rate limit from 60 to 5000 req/hour.
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos).
# Without this, large repos may fall back to git clone (requires git in the deployment env).
GITHUB_TOKEN=
# Optional overrides (have sensible defaults):
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# EMBEDDING_MODEL=gemini-embedding-001
# THINKER_COOLDOWN_DEFAULT_SECS=60

